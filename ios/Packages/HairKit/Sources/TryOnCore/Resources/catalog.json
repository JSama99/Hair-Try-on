{
  "version": 1,
  "note": "Single source of truth for the iOS app (TryOnCore.Catalog) and the browser studio (web/src/tryon.js). Widths and lengths are metres; colours are sRGB hex. Braiding-hair colour codes follow the industry numbering used on pre-stretched braiding hair packs.",
  "styles": [
    {
      "id": "knotless_braids", "kind": "knotless_braids", "name": "Knotless braids",
      "blurb": "Starts with your own hair at the root and feeds in, so the base is flat and light on the scalp.",
      "sizes": [
        { "id": "small", "label": "Small", "width": 0.012 },
        { "id": "medium", "label": "Medium", "width": 0.018 },
        { "id": "large", "label": "Large", "width": 0.024 },
        { "id": "jumbo", "label": "Jumbo", "width": 0.032 }
      ],
      "defaultSize": "medium", "defaultLength": "armpit"
    },
    {
      "id": "box_braids", "kind": "box_braids", "name": "Box braids",
      "blurb": "Square parts with a small knot at each root; the classic three-strand plait.",
      "sizes": [
        { "id": "small", "label": "Small", "width": 0.012 },
        { "id": "medium", "label": "Medium", "width": 0.018 },
        { "id": "large", "label": "Large", "width": 0.024 },
        { "id": "jumbo", "label": "Jumbo", "width": 0.032 }
      ],
      "defaultSize": "medium", "defaultLength": "armpit"
    },
    {
      "id": "two_strand_twists", "kind": "two_strand_twists", "name": "Two-strand twists",
      "blurb": "Two strands wrapped around each other; softer and rounder than a plait.",
      "sizes": [
        { "id": "small", "label": "Small", "width": 0.012 },
        { "id": "medium", "label": "Medium", "width": 0.018 },
        { "id": "large", "label": "Large", "width": 0.026 }
      ],
      "defaultSize": "medium", "defaultLength": "shoulder"
    },
    {
      "id": "locs", "kind": "locs", "name": "Locs",
      "blurb": "Single ropes with natural thickness variation, for faux locs or a preview of your own.",
      "sizes": [
        { "id": "micro", "label": "Micro", "width": 0.010 },
        { "id": "medium", "label": "Medium", "width": 0.018 },
        { "id": "large", "label": "Large", "width": 0.026 }
      ],
      "defaultSize": "medium", "defaultLength": "shoulder"
    },
    {
      "id": "cornrows", "kind": "cornrows", "name": "Cornrows",
      "blurb": "Straight-back rows braided flat to the scalp, with the tails left loose at the nape.",
      "sizes": [
        { "id": "small", "label": "14 rows", "width": 0.012, "rows": 14 },
        { "id": "medium", "label": "10 rows", "width": 0.018, "rows": 10 },
        { "id": "large", "label": "6 rows", "width": 0.026, "rows": 6 }
      ],
      "defaultSize": "medium", "defaultLength": "shoulder"
    }
  ],
  "lengths": [
